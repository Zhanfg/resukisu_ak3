+    private int hookNotificationPost() {
+        int count = 0;
+        for (Method method : NotificationManager.class.getDeclaredMethods()) {
+            if (!(method.getName().equals("notify") || method.getName().equals("notifyAsPackage"))) continue;
+            Class<?>[] types = method.getParameterTypes();
+            boolean hasNotification = false;
+            for (Class<?> type : types) if (type == Notification.class) hasNotification = true;
+            if (!hasNotification) continue;
+            try {
+                hook(method).intercept(chain -> {
+                    Object[] args = chain.getArgs().toArray();
+                    for (Object arg : args) {
+                        if (arg instanceof Notification notification) translateNotification(notification);
+                    }
+                    return chain.proceed(args);
+                });
+                count++;
+            } catch (Throwable error) {
+                log(Log.WARN, TAG, "Notification post hook failed: " + method, error);
+            }
+        }
+        return count;
+    }
