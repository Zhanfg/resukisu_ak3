+    private static void translateChannelArgument(Object value) {
+        if (value instanceof NotificationChannel channel) {
+            CharSequence name = channel.getName();
+            if (name != null) channel.setName(Translator.translateNotificationCharSequence(name));
+            String description = channel.getDescription();
+            if (description != null) channel.setDescription(Translator.translateNotification(description));
+            return;
+        }
+        if (value instanceof NotificationChannelGroup group) {
+            if (android.os.Build.VERSION.SDK_INT >= 28) {
+                String description = group.getDescription();
+                if (description != null) group.setDescription(Translator.translateNotification(description));
+            }
+            return;
+        }
+        if (value instanceof List<?> list) {
+            for (Object item : list) translateChannelArgument(item);
+        }
+    }
+
+    private static void translateNotification(Notification notification) {
+        Bundle extras = notification.extras;
+        if (extras == null) return;
+        translateExtra(extras, Notification.EXTRA_TITLE);
+        translateExtra(extras, Notification.EXTRA_TITLE_BIG);
+        translateExtra(extras, Notification.EXTRA_TEXT);
+        translateExtra(extras, Notification.EXTRA_SUB_TEXT);
+        translateExtra(extras, Notification.EXTRA_INFO_TEXT);
+        translateExtra(extras, Notification.EXTRA_SUMMARY_TEXT);
+        translateExtra(extras, Notification.EXTRA_BIG_TEXT);
+
+        CharSequence[] lines = extras.getCharSequenceArray(Notification.EXTRA_TEXT_LINES);
+        if (lines != null) {
+            boolean changed = false;
+            CharSequence[] translated = new CharSequence[lines.length];
+            for (int i = 0; i < lines.length; i++) {
+                translated[i] = Translator.translateNotificationCharSequence(lines[i]);
+                changed |= translated[i] != lines[i];
+            }
+            if (changed) extras.putCharSequenceArray(Notification.EXTRA_TEXT_LINES, translated);
+        }
+    }
+
+    private static void translateExtra(Bundle extras, String key) {
+        CharSequence value = extras.getCharSequence(key);
+        if (value == null) return;
+        CharSequence translated = Translator.translateNotificationCharSequence(value);
+        if (translated != value) extras.putCharSequence(key, translated);
+    }
