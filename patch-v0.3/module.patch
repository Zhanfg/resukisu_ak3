+    private int hookNotificationBuild() {
+        try {
+            Method build = Notification.Builder.class.getDeclaredMethod("build");
+            hook(build).intercept(chain -> {
+                Object result = chain.proceed();
+                if (result instanceof Notification notification) translateNotification(notification);
+                return result;
+            });
+            return 1;
+        } catch (Throwable error) {
+            log(Log.WARN, TAG, "Notification.Builder.build hook failed", error);
+            return 0;
+        }
+    }
