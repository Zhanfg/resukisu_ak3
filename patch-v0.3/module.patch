+    private int hookLicenseRenderer(ClassLoader classLoader) {
+        try {
+            Class<?> renderer = Class.forName(LICENSE_RENDERER_199, false, classLoader);
+            int count = 0;
+            for (Method method : renderer.getDeclaredMethods()) {
+                if (!method.getName().equals("a")) continue;
+                method.setAccessible(true);
+                hook(method).intercept(chain -> {
+                    Translator.enterLicenseRender();
+                    try {
+                        return chain.proceed();
+                    } finally {
+                        Translator.exitLicenseRender();
+                    }
+                });
+                count++;
+            }
+            return count;
+        } catch (Throwable error) {
+            log(Log.WARN, TAG, "Linear 1.99 license renderer guard unavailable", error);
+            return 0;
+        }
+    }
