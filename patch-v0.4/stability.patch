+    private static Field[] findListFields(Class<?> type) {
+        java.util.ArrayList<Field> fields = new java.util.ArrayList<>();
+        for (Field field : type.getDeclaredFields()) {
+            if (!List.class.isAssignableFrom(field.getType())) continue;
+            try { field.setAccessible(true); } catch (Throwable ignored) { continue; }
+            fields.add(field);
+        }
+        return fields.toArray(new Field[0]);
+    }
+
+    private static boolean isSafePlainAnnotated(Object annotated, Field[] listFields) {
+        int length;
+        if (annotated instanceof CharSequence chars) length = chars.length();
+        else {
+            String text = annotated.toString();
+            length = text.length();
+        }
+        if (!Translator.isSafeUiLength(length)) return false;
+        // If the obfuscated AnnotatedString shape changed, fail closed instead of stripping rich metadata.
+        if (listFields.length == 0) return false;
+        for (Field field : listFields) {
+            try {
+                Object value = field.get(annotated);
+                if (value instanceof List<?> list && !list.isEmpty()) return false;
+            } catch (Throwable ignored) {
+                return false;
+            }
+        }
+        return true;
+    }
